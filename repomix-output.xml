<file path="cli/src/main/java/se/dungeonsandmorons/game/GameLoop.java">
package se.dungeonsandmorons.game;

import se.dungeonsandmorons.screen.*;
import se.dungeonsandmorons.screen.IO;

import java.util.Map;

public class GameLoop {

    private final GameContext context;
    private final Map<GameState, Screen> screens;

    public GameLoop(GameContext context) {
        this.context = context;
        this.screens = Map.of(
                GameState.MAIN_MENU, new MainMenuScreen(),
                GameState.LOAD_MENU, new LoadScreen(),
                GameState.CHARACTER_CREATION, new CreateCharacterScreen(),
                GameState.IN_TOWN, new TownScreen(),
                GameState.TALKING_TO_NPC, new TalkingToNpcScreen(),
                GameState.SELECTING_DUNGEON, new DungeonSelectScreen(),
                GameState.EXPLORING_DUNGEON, new ExploringDungeonScreen(),
                GameState.IN_COMBAT, new CombatScreen(),
                GameState.STAT_MANAGEMENT, new AllocateStatsScreen()
        );
    }

    public void run() {
        while (context.getStateMachine().getCurrentState() != GameState.GAME_OVER) {
            GameState currentState = context.getStateMachine().getCurrentState();
            Screen currentScreen = screens.get(currentState);

            if (currentScreen == null) {
                throw new IllegalStateException("No screen mapped for state: " + currentState);
            }

            currentScreen.display(context);
            String input = IO.readln("> ");
            currentScreen.handleInput(input, context);
        }
    }

}
</file>

<file path="cli/src/main/java/se/dungeonsandmorons/screen/CreateCharacterScreen.java">
package se.dungeonsandmorons.screen;

import se.dungeonsandmorons.game.GameContext;
import se.dungeonsandmorons.game.GameEvent;
import se.dungeonsandmorons.model.character.CharacterClass;
import se.dungeonsandmorons.model.character.Kharacter;
import se.dungeonsandmorons.town.TownRegistry;

public class CreateCharacterScreen implements Screen {

    @Override
    public void display(GameContext context) {
        IO.println("""
        
        === Character Creation ===
        
        Classes: Warrior | Magician | Archer
        Usage:      create <name> <class>
        Example:    create Cliff Hanger Warrior
        
        Type 'back' to return to Main Menu.
        """);
    }

    @Override
    public void handleInput(String input, GameContext context) {
        String trimmed = input.trim();

        if (trimmed.equalsIgnoreCase("back")) {
            context.getStateMachine().transition(GameEvent.CANCEL);
            return;
        }

        if (!trimmed.toLowerCase().startsWith("create ")) {
            IO.println("Invalid format. Use: create <name> <class>");
            return;
        }

        String payload = trimmed.substring("create ".length()).trim();

        int lastSpaceIndex = payload.lastIndexOf(' ');
        if (lastSpaceIndex == -1) {
            IO.println(String.format("Missing class! Example: create %s Warrior", payload));
            return;
        }

        String characterName = payload.substring(0, lastSpaceIndex).trim();
        String characterClass = payload.substring(lastSpaceIndex + 1).trim();

        if (characterName.isBlank()) {
            IO.println("Character name cannot be blank.");
            return;
        }

        if (context.getSaveService().saveExists(characterName)) {
            IO.println(String.format("Character with name '%s' already exists!", characterName));
            return;
        }

        switch (characterClass.toLowerCase()) {
            case "warrior"  -> {
                context.setPlayer(new Kharacter(characterName, CharacterClass.WARRIOR));
                context.setActiveTown(TownRegistry.get("Densewood"));
                IO.println(String.format("Character created: %s the Warrior!", characterName));
                context.getStateMachine().transition(GameEvent.ENTER_TOWN);
            }

            case "archer"  -> {
                context.setPlayer(new Kharacter(characterName, CharacterClass.ARCHER));
                context.setActiveTown(TownRegistry.get("Densewood"));
                IO.println(String.format("Character created: %s the Archer!", characterName));
                context.getStateMachine().transition(GameEvent.ENTER_TOWN);
            }

            case "magician"  -> {
                context.setPlayer(new Kharacter(characterName, CharacterClass.MAGICIAN));
                context.setActiveTown(TownRegistry.get("Densewood"));
                IO.println(String.format("Character created: %s the Magician!", characterName));
                context.getStateMachine().transition(GameEvent.ENTER_TOWN);
            }
            default         -> IO.println(String.format("Unknown class '%s'.", characterClass));
        }

    }


}
</file>

<file path="cli/src/main/java/se/dungeonsandmorons/screen/LoadScreen.java">
package se.dungeonsandmorons.screen;

import se.dungeonsandmorons.repository.CharacterSummary;
import se.dungeonsandmorons.exception.CorruptedSaveException;
import se.dungeonsandmorons.game.GameContext;
import se.dungeonsandmorons.game.GameEvent;
import se.dungeonsandmorons.town.TownRegistry;

import java.util.List;

public class LoadScreen implements Screen {

    @Override
    public void display(GameContext context) {
        IO.print("""
                
                === Saved Characters ===
                
                """);
        List<CharacterSummary> saves = context.getSaveService().getAvailableSaves();

        if (saves != null && !saves.isEmpty()) {
            for (CharacterSummary save : saves) {
                IO.println(save);
            }
        } else {
            IO.println("No saved characters");
        }

        IO.print("""
                
                Type character name to load, or 'back' to return.
                Name is case-sensitive
                
                """);
    }

    @Override
    public void handleInput(String input, GameContext context) {
        String trimmed = input.trim();

        if (trimmed.equalsIgnoreCase("back")) {
            context.getStateMachine().transition(GameEvent.CANCEL);
            return;
        }

        try {
            context.getSaveService().loadGame(trimmed).ifPresentOrElse(saveData -> {
                context.setPlayer(saveData.player());
                String townName = saveData.lastTownVisited() != null
                        ? saveData.lastTownVisited()
                        : "Densewood";
                context.setActiveTown(TownRegistry.get(townName));

                IO.println("Character loaded successfully!");
                context.getStateMachine().transition(GameEvent.ENTER_TOWN);
            }, () -> IO.println("Failed to load character"));
        } catch (CorruptedSaveException e) {
            IO.println("Error: " + e.getMessage());
            IO.println("Returning to Main Menu...");
            context.getStateMachine().transition(GameEvent.LOAD_GAME_FAIL);
        }

    }

}
</file>

